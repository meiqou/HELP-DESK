# ---------------------------------------------------------------------------
# Apache hardening for the web root
# ---------------------------------------------------------------------------

Options -Indexes -MultiViews
ServerSignature Off

# Block hidden files and anything that is not part of the site
<FilesMatch "(^\.|\.(sql|md|ini|log|bak|old|swp|dist|lock|json)$|~$)">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_flag session.cookie_httponly On
    php_flag session.use_strict_mode On
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Only the HTTP methods the application uses
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Uncomment once HTTPS is configured to force encrypted connections:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
